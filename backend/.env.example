APP_NAME="Enterprise POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos
DB_USERNAME=pos_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPA (Sanctum cookie auth): origins allowed to receive stateful sessions
FRONTEND_URL=http://localhost:5173

# Online storefront (docs/ecommerce/DECISIONS.md ADR-001, ADR-010)
# Requests to localhost/127.0.0.1 are served as this storefront host (add it as a domain in the admin).
STOREFRONT_DEFAULT_HOST=shop.localhost
MEDIA_DISK=public
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# POS behaviour (config/pos.php)
POS_DEFAULT_CURRENCY=BDT
POS_DEFAULT_TIMEZONE=Asia/Dhaka
POS_REGISTRATION_ENABLED=true
POS_DEVICE_TOKEN_TTL_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "redis" for queue/cache/session in staging & production; "database" works without Redis locally.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Rate limits per minute (defaults shown). Full-stack e2e runs raise them (docs/TESTING_GUIDE.md).
# POS_API_RATE_LIMIT=120
# POS_AUTH_RATE_LIMIT=5
# POS_CHECKOUT_RATE_LIMIT=10
# POS_COUPON_RATE_LIMIT=10
# POS_REVIEW_RATE_LIMIT=5

# Behind a TLS-terminating proxy/load balancer: its addresses (comma-separated, CIDR) or *
# TRUSTED_PROXIES=

# List exports (X1): row limits per format, exports per user per minute, rows fetched per chunk
# EXPORT_MAX_ROWS_XLSX=50000
# EXPORT_MAX_ROWS_PDF=2000
# EXPORT_MAX_ROWS_CSV=100000
# EXPORT_RATE_LIMIT=10
# EXPORT_CHUNK_SIZE=500

# PDF rendering through headless Chromium (Browsershot + backend/pdf-renderer). Empty = auto-detect
# (Playwright's Chromium locally, /usr/bin/chromium etc. on Linux).
# PDF_CHROME_PATH=/usr/bin/chromium
# PDF_NODE_BINARY=/usr/bin/node
# PDF_NPM_BINARY=/usr/bin/npm
# PDF_NODE_MODULES_PATH=
# PDF_RENDERER_SCRIPT=
# PDF_TIMEOUT=60
# PDF_NO_SANDBOX=false

# Optional AI module (Phase 8, docs/AI_INTEGRATION.md). Off by default; every POS function works without it.
# The key is never logged or returned. AI_MONTHLY_TOKEN_BUDGET is the per-organization default (0 = unlimited).
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=
# AI_TIMEOUT=30
# AI_MAX_TOOL_ROUNDS=4
# AI_MONTHLY_TOKEN_BUDGET=2000000
# AI_TOOL_ROW_LIMIT=50
# AI_ASK_RATE_LIMIT=20
# AI_MAX_TOKENS=8000
# AI_EFFORT=low
# AI_REFUSAL_FALLBACK=true
# AI_MAX_RETRIES=2
# AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_ANTHROPIC_VERSION=2026-10-21
