                                    {
                                        "id": "q1",
                                        "title": "When will my order arrive?",
                                        "html": "<p>Delivery times for each area are shown above. Festival days are busy, so please order a few days early.</p>"
                                    },
                                    {
                                        "id": "q2",
                                        "title": "Can I pay cash on delivery?",
                                        "html": "<p>Where cash on delivery is available, you will see it at checkout.</p>"
                                    },
                                    {
                                        "id": "q3",
                                        "title": "How do I use the discount code?",
                                        "html": "<p>Copy the code above and enter it at checkout before you place your order.</p>"
                                    },
                                    {
                                        "id": "q4",
                                        "title": "Can I exchange a gift?",
                                        "html": "<p>Yes. Please keep the product unused with its tag and contact us within 7 days of delivery.</p>"
                                    }
