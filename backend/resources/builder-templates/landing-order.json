                                        "id": "i1",
                                        "title": "How do I order?",
                                        "html": "<p>Fill in the form below with your name, phone number and address, then confirm. We will call you to confirm the order.</p>"
                                    },
                                    {
                                        "id": "i2",
                                        "title": "When will I get it?",
                                        "html": "<p>Inside Dhaka in 1–2 days, elsewhere in 2–5 days.</p>"
                                    },
