                },
                {
                    "id": "c_2",
                    "type": "column",
                    "width": { "base": 65, "tablet": 100, "mobile": 100 },
                    "elements": [
                        {
                            "id": "e_4",
                            "type": "accordion",
                            "props": {
                                "items": [
                                    { "id": "q1", "title": "How long does delivery take?", "html": "<p>Orders in the city arrive within 1 to 2 days, elsewhere within 3 to 5 days.</p>" },
                                    { "id": "q2", "title": "Can I pay on delivery?", "html": "<p>Yes. You can pay in cash when the order arrives, or online when you check out.</p>" },
                                    { "id": "q3", "title": "Can I return an item?", "html": "<p>Unused items can be returned within 7 days of delivery. Contact us to arrange a pickup.</p>" },
                                    { "id": "q4", "title": "Do you deliver outside the country?", "html": "<p>Not yet. We deliver everywhere in the country.</p>" }
                                ],
                                "open_first": true,
                                "allow_multiple": false,
                                "style": "boxed"
                            },
                            "translations": {
                                "bn": {
                                    "items.q1.title": "ডেলিভারিতে কত দিন লাগে?",
                                    "items.q1.html": "<p>শহরের ভেতরে ১ থেকে ২ দিন, অন্যত্র ৩ থেকে ৫ দিন।</p>",
                                    "items.q2.title": "পণ্য হাতে পেয়ে কি টাকা দিতে পারব?",
                                    "items.q2.html": "<p>হ্যাঁ। পণ্য হাতে পেয়ে নগদে অথবা চেকআউটের সময় অনলাইনে পরিশোধ করতে পারেন।</p>",
                                    "items.q3.title": "পণ্য কি ফেরত দেওয়া যায়?",
                                    "items.q3.html": "<p>অব্যবহৃত পণ্য ডেলিভারির ৭ দিনের মধ্যে ফেরত দেওয়া যায়। পিকআপের জন্য আমাদের সাথে যোগাযোগ করুন।</p>",
                                    "items.q4.title": "দেশের বাইরে কি ডেলিভারি দেন?",
                                    "items.q4.html": "<p>এখনো না। আমরা দেশের সব জায়গায় ডেলিভারি দিই।</p>"
                                }
                            }
                        }
                    ]
