                        },
                        {
                            "id": "e_2",
                            "type": "text",
                            "props": { "html": "<p>Can't find what you are looking for? Write to us and we will reply within a day.</p>" },
                            "translations": { "bn": { "html": "<p>যা খুঁজছেন পাচ্ছেন না? আমাদের লিখুন, এক দিনের মধ্যে উত্তর দেব।</p>" } }
                        },
