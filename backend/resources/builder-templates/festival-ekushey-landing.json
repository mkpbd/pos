                            "props": {
                                "text": "Can I ever forget the twenty-first of February, reddened with my brothers’ blood?",
                                "author": "Abdul Gaffar Chowdhury",
                                "role": "1952",
                                "style": "large"
                            },
                            "translations": {
                                "bn": {
                                    "text": "আমার ভাইয়ের রক্তে রাঙানো একুশে ফেব্রুয়ারি, আমি কি ভুলিতে পারি",
                                    "author": "আবদুল গাফফার চৌধুরী",
                                    "role": "১৯৫২"
                                }
                            },
